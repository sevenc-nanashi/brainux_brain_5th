#!/bin/sh
set -eu
[ "$#" -eq 1 ] || { echo 'usage: boot-root /dev/mmcblk0p2' >&2; exit 1; }
case "$1" in /dev/mmcblk0p[0-9]*) ;; *) echo 'Only the SD card is supported' >&2; exit 1 ;; esac
[ -b "$1" ] || {
    echo "Block device not found: $1" >&2
    echo 'Available partitions:' >&2
    cat /proc/partitions >&2
    echo 'An SD ext4 partition containing a Brainux rootfs is required.' >&2
    exit 1
}
if mountpoint -q /newroot; then
    echo '/newroot is already mounted; unmount it before retrying' >&2
    exit 1
fi
mount -t ext4 -o ro "$1" /newroot
trap 'umount /newroot' EXIT
if ! chroot /newroot /bin/sh -c 'test -x /sbin/init'; then
    echo 'Cannot run rootfs /bin/sh, or /sbin/init is missing' >&2
    exit 1
fi
for dir in dev proc sys run; do
    path=/newroot/$dir
    if [ -L "$path" ] || { [ -e "$path" ] && [ ! -d "$path" ]; }; then
        echo "Not a real mount directory: $path" >&2
        exit 1
    fi
done
# The distributed rootfs has no fstab entry to remount / writable at startup.
mount -o remount,rw /newroot
mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run
# Apply board settings to the validated rootfs before handing it to systemd.
for fix in fix-sd fix-screen fix-touch fix-usb; do
    if ! /sbin/"$fix" --mounted; then
        echo "Automatic setup failed: $fix; rootfs was not started." >&2
        exit 1
    fi
done
# PID 1 performs switch_root; a shell command cannot replace init on its own.
trap - EXIT
kill -USR1 1 || { umount /newroot; exit 1; }
