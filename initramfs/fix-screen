#!/bin/sh
set -eu
. /lib/brainux-fix.sh
config=/newroot/etc/X11/xorg.conf
[ -f "$config" ] && [ ! -L "$config" ] || { echo 'xorg.conf not found or is a symlink' >&2; exit 1; }
driver='^[[:space:]]*Driver[[:space:]]*"fbdev"[[:space:]]*$'
[ "$(grep -c "$driver" "$config")" -eq 1 ] || { echo 'Expected one fbdev device; unchanged' >&2; exit 1; }
if grep -q '"Rotate"' "$config"; then
    echo 'Rotation already configured; unchanged'
    exit 0
fi
mount -o remount,rw /newroot
# fbdev CW maps (x,y) to (479-y,x), matching fbcon=rotate:1.
sed -i "/$driver/a\\        Option \"Rotate\" \"CW\"" "$config"
grep -q 'Option "Rotate" "CW"' "$config"
echo 'Fixed: Xorg rotation CW; takes effect at the next GUI start'
