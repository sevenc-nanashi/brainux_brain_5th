#!/bin/sh
set -eu
. /lib/brainux-fix.sh
unit=/newroot/usr/lib/systemd/system/boot.mount
[ -f "$unit" ] && [ ! -L "$unit" ] || { echo 'boot.mount not found or is a symlink' >&2; exit 1; }
if grep -qx 'What=/dev/mmcblk0p1' "$unit"; then
    echo 'Already fixed: /boot uses /dev/mmcblk0p1'
    exit 0
fi
grep -qx 'What=/dev/mmcblk1p1' "$unit" || { echo 'Unexpected boot.mount device; unchanged' >&2; exit 1; }
mount -o remount,rw /newroot
sed -i 's|^What=/dev/mmcblk1p1$|What=/dev/mmcblk0p1|' "$unit"
grep -qx 'What=/dev/mmcblk0p1' "$unit"
echo 'Fixed: /boot uses /dev/mmcblk0p1'
