#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t devtmpfs devtmpfs /dev || exec /bin/sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /dev/pts /run /newroot
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
# Keep kernel messages in dmesg without scrolling the diagnostic screen.
dmesg -n 1
printf '\033[2J\033[HBrainux PW-H1 initramfs started (diag 56, @BUILD_REVISION@)\n'
if [ -e /proc/device-tree/chosen/brainux,display-only ]; then
    echo 'Display check: USB disabled.'
else
# USB provides an additional serial console when enabled.
echo 'USB: configuring serial console'
# A separate shell keeps errexit effective when the caller handles failure.
/bin/sh -e > /run/usb-setup.log 2>&1 <<'USB_SETUP'
    mount -t configfs configfs /sys/kernel/config
    cd /sys/kernel/config/usb_gadget
    mkdir brainux
    cd brainux
    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    mkdir -p strings/0x409 configs/c.1/strings/0x409 functions/acm.usb0
    echo 'Brainux' > strings/0x409/manufacturer
    echo 'PW-H1 bring-up console' > strings/0x409/product
    echo 'USB serial' > configs/c.1/strings/0x409/configuration
    ln -s functions/acm.usb0 configs/c.1/acm.usb0
    attempts=0
    echo 'USB: waiting for controller'
    while :; do
        set -- /sys/class/udc/*
        if [ -e "$1" ]; then break; fi
        attempts=$((attempts + 1))
        [ "$attempts" -lt 10 ] || { echo 'USB: no controller registered'; exit 1; }
        sleep 1
    done
    [ "$#" -eq 1 ]
    echo "${1##*/}" > UDC
    echo "USB: serial console bound to ${1##*/}"
USB_SETUP
usb_status=$?
printf '\033[2J\033[HBrainux PW-H1 initramfs started (diag 56, @BUILD_REVISION@)\n'
if [ "$usb_status" -ne 0 ]; then
    echo "USB gadget setup failed (exit $usb_status)"
    /bin/sh /sbin/usb-report > /run/usb-report.log 2>&1
    fold -w 48 -s /run/usb-report.log | head -n 22
elif [ -c /dev/ttyGS0 ]; then
    echo 'USB serial ready: connect the PC and open its COM port (115200).'
    (while :; do /sbin/getty -L -n -l /bin/sh 115200 ttyGS0 vt100; sleep 1; done) > /run/usb-getty.log 2>&1 &
else
    echo 'USB bound, but /dev/ttyGS0 is missing'
fi
fi
dmesg | sed -n '/PW-H1: TPM CONF/p'
dmesg | sed -n '/PW-H1: idle /p'
printf 'Clocksource: '
cat /sys/devices/system/clocksource/clocksource0/current_clocksource
echo 'Keyboard: aaA1 toggles letters / symbols.'
echo 'Type keymap for layout; keycodes for raw codes.'

switch_to_root() {
    for dir in proc sys run dev; do
        if [ ! -d "/newroot/$dir" ] || [ -L "/newroot/$dir" ]; then
            echo "Root switch refused: /newroot/$dir is not a mount directory"
            return
        fi
    done
    trap '' USR1
    kill -TERM -1
    sleep 1
    kill -KILL -1
    moved=
    for dir in proc sys run dev; do
        if ! mount --move "/$dir" "/newroot/$dir"; then
            echo "Root switch failed at /$dir; restoring initramfs mounts"
            for previous in $moved; do
                if ! mount --move "/newroot/$previous" "/$previous"; then
                    echo "Cannot restore /$previous; reset required"
                    while :; do sleep 60; done
                fi
            done
            umount /newroot
            trap switch_to_root USR1
            return
        fi
        moved="$dir $moved"
    done
    exec switch_root /newroot /sbin/init
}
trap switch_to_root USR1
# BusyBox reboot signals PID 1; the initramfs uses this shell as init.
trap 'echo "Reboot: syncing filesystems"; sync; /bin/busybox reboot -f' TERM
trap 'echo "Poweroff is unsupported; use reboot."' USR2
if [ -L /sys/bus/platform/devices/4103d058.reboot/driver ]; then
    echo 'Reset driver: bound'
else
    echo 'Reset driver: MISSING'
fi
echo 'Type reboot to start the original system.'
echo 'Type fix-screen once to rotate the Xorg desktop.'
echo 'Type fix-sd once to fix the SD boot partition path.'
echo 'Use boot-root /dev/mmcblk0p2 to start an existing Brainux rootfs.'
while :; do setsid cttyhack /bin/sh & wait "$!"; sleep 1; done
