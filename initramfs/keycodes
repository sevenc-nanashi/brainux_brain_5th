#!/bin/sh
set -eu
keys=/sys/bus/platform/devices/1fff8080.keyboard/raw_keys
[ -r "$keys" ] || { echo 'Keyboard state unavailable' >&2; exit 1; }
tty_mode=$(stty -g)
trap 'stty "$tty_mode"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
stty -echo -icanon min 0 time 0
echo 'Press and release keys; returns in about 20 seconds.'
echo 'Hold each key briefly. At most two keys together.'
previous=''
count=0
while [ "$count" -lt 100 ]; do
    current=$(cat "$keys")
    if [ "$current" != "$previous" ]; then
        printf '%s\n' "$current"
        previous=$current
    fi
    # Consume diagnostic keystrokes so they cannot become shell commands.
    dd bs=256 count=1 of=/dev/null 2>/dev/null
    sleep 0.2
    count=$((count + 1))
done
dd bs=256 count=1 of=/dev/null 2>/dev/null
