#!/bin/sh
set -eu
run=/sys/bus/platform/devices/40410000.idle-test/run
keys=/sys/bus/platform/devices/1fff8080.keyboard/raw_keys
[ -w "$run" ] && [ -r "$keys" ] || { echo 'WFI diagnostic unavailable' >&2; exit 1; }
snapshot() {
    printf 'Uptime: '
    cat /proc/uptime
    awk '/arch_timer|i.MX TPM/ {print}' /proc/interrupts
    printf 'Keys: '
    cat "$keys"
}
echo 'Clocksource:'
cat /sys/devices/system/clocksource/clocksource0/current_clocksource
echo 'BEFORE: one WFI with shallow SMC mode.'
echo 'At ENTER, wait 3 seconds, then press a key.'
echo 'If still frozen, record the last marker and reset.'
snapshot
sync
printf '1\n' > "$run"
echo 'AFTER: press/release A; watching for 10 seconds.'
i=0
while [ "$i" -lt 10 ]; do
    snapshot
    sleep 1
    i=$((i + 1))
done
echo 'DONE: normal idle is still polling.'

echo 'TPM / GIC report (PRE and POST):'
dmesg | sed -n '/WFI TEST:/p' | tail -n 13
