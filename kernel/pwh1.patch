+			val = readl_relaxed(reg);
+			val &= ~(1 << PCG_CGC_SHIFT);
+			writel_relaxed(val, reg);
+		}
 	}
 
 	hw = clk_hw_register_composite(NULL, name, parent_names, num_parents,
