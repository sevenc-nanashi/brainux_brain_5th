diff --git a/arch/arm/mach-imx/mach-imx7ulp.c b/arch/arm/mach-imx/mach-imx7ulp.c
index 6ab1a0176..df7c48af5 100644
--- a/arch/arm/mach-imx/mach-imx7ulp.c
+++ b/arch/arm/mach-imx/mach-imx7ulp.c
@@ -5,6 +5,7 @@
  *   Author: Dong Aisheng <aisheng.dong@nxp.com>
  */
 
+#include <linux/io.h>
 #include <linux/irqchip.h>
 #include <linux/mfd/syscon.h>
 #include <linux/of_platform.h>
@@ -65,9 +66,30 @@ static void __init imx7ulp_set_revision(void)
 	}
 }
 
+static void __init pwh1_init_early(void)
+{
+	void __iomem *smc;
+	u32 before, after, mask = GENMASK(17, 16) | GENMASK(2, 0);
+
+	if (!of_machine_is_compatible("sharp,pw-h1-brainux"))
+		return;
+	smc = ioremap(MX7ULP_SMC1_BASE_ADDR, MX7ULP_SMC1_SIZE);
+	if (!smc)
+		panic("PW-H1: cannot map SMC1");
+	/* PSTOP3 retains the bus clocks needed by TPM and display scanout. */
+	before = readl(smc + 0x10);
+	writel((before & ~mask) | (3 << 16), smc + 0x10);
+	after = readl(smc + 0x10);
+	if ((after & mask) != (3 << 16))
+		panic("PW-H1: cannot configure shallow idle: %08x", after);
+	pr_info("PW-H1: shallow WFI, SMC1 PMCTRL %08x -> %08x\n", before, after);
+	iounmap(smc);
+}
+
 static void __init imx7ulp_init_machine(void)
 {
-	imx7ulp_pm_init();
+	if (!of_machine_is_compatible("sharp,pw-h1-brainux"))
+		imx7ulp_pm_init();
 
 	mxc_set_cpu_type(MXC_CPU_IMX7ULP);
 	imx7ulp_set_revision();
@@ -87,6 +109,9 @@ static void __init imx7ulp_map_io(void)
 
 static void __init imx7ulp_init_late(void)
 {
+	if (of_machine_is_compatible("sharp,pw-h1-brainux"))
+		return;
+
 	if (IS_ENABLED(CONFIG_ARM_IMX_CPUFREQ_DT))
 		platform_device_register_simple("imx-cpufreq-dt", -1, NULL, 0);
 
@@ -96,6 +121,7 @@ static void __init imx7ulp_init_late(void)
 
 DT_MACHINE_START(IMX7ulp, "Freescale i.MX7ULP (Device Tree)")
 	.map_io		= imx7ulp_map_io,
+	.init_early	= pwh1_init_early,
 	.init_machine	= imx7ulp_init_machine,
 	.dt_compat	= imx7ulp_dt_compat,
 	.init_late	= imx7ulp_init_late,
