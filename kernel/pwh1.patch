diff --git a/drivers/base/syscore.c b/drivers/base/syscore.c
index 13db1f78d..b7f1fc2e1 100644
--- a/drivers/base/syscore.c
+++ b/drivers/base/syscore.c
@@ -6,6 +6,7 @@
  */
 
 #include <linux/syscore_ops.h>
+#include <linux/of.h>
 #include <linux/mutex.h>
 #include <linux/module.h>
 #include <linux/suspend.h>
@@ -114,15 +115,24 @@ EXPORT_SYMBOL_GPL(syscore_resume);
 void syscore_shutdown(void)
 {
 	struct syscore_ops *ops;
+	bool pwh1 = of_machine_is_compatible("sharp,pw-h1-brainux");
 
+	if (pwh1)
+		pr_emerg("PWH1: core lock\n");
 	mutex_lock(&syscore_ops_lock);
 
 	list_for_each_entry_reverse(ops, &syscore_ops_list, node)
 		if (ops->shutdown) {
 			if (initcall_debug)
 				pr_info("PM: Calling %pS\n", ops->shutdown);
+			if (pwh1)
+				pr_emerg("PWH1: core %ps\n", ops->shutdown);
 			ops->shutdown();
+			if (pwh1)
+				pr_emerg("PWH1: core done\n");
 		}
 
 	mutex_unlock(&syscore_ops_lock);
+	if (pwh1)
+		pr_emerg("PWH1: core finished\n");
 }
