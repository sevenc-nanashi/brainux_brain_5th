diff --git a/drivers/clocksource/timer-imx-tpm.c b/drivers/clocksource/timer-imx-tpm.c
index 92c025b70..227b2e69a 100644
--- a/drivers/clocksource/timer-imx-tpm.c
+++ b/drivers/clocksource/timer-imx-tpm.c
@@ -9,9 +9,13 @@
 #include <linux/delay.h>
 #include <linux/interrupt.h>
 #include <linux/sched_clock.h>
+#include <linux/of.h>
 
 #include "timer-of.h"
 
+#define TPM_CONF			0x84
+#define TPM_CONF_DOZEEN			BIT(5)
+
 #define TPM_PARAM			0x4
 #define TPM_PARAM_WIDTH_SHIFT		16
 #define TPM_PARAM_WIDTH_MASK		(0xff << 16)
@@ -219,6 +223,17 @@ static int __init tpm_timer_init(struct device_node *np)
 	 */
 	/* make sure counter is disabled */
 	writel(0, timer_base + TPM_SC);
+	if (of_machine_is_compatible("sharp,pw-h1-brainux")) {
+		u32 before = readl(timer_base + TPM_CONF);
+		u32 after;
+
+		/* The firmware may pause TPM in Doze; Linux needs its wake tick. */
+		writel(before & ~TPM_CONF_DOZEEN, timer_base + TPM_CONF);
+		after = readl(timer_base + TPM_CONF);
+		if (after & TPM_CONF_DOZEEN)
+			panic("PW-H1: TPM still stops in Doze");
+		pr_info("PW-H1: TPM CONF %08x -> %08x\n", before, after);
+	}
 	/* TOF is W1C */
 	writel(TPM_SC_TOF_MASK, timer_base + TPM_SC);
 	writel(0, timer_base + TPM_CNT);
